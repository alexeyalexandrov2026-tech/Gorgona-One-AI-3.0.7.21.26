{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gorgonaoneai3072126",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers AI answers the concierge chat (app/api/chat). No API key: the
  // model is reached through this binding, billed to this Cloudflare account.
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
