{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gorgonaoneai3072126",
  "workers_dev": false,
  "preview_urls": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "CONCIERGE_AI" },
  "vars": {
    "APP_ENV": "production",
    "CONCIERGE_WORKERS_AI_ENABLED": "true",
    "MY_MIAMI_ENABLED": "true",
    "PLAN_REQUESTS_ENABLED": "true",
    "NEXT_PUBLIC_RENTALS_MEDIA_BASE_URL": "https://media.gorgona-one.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
