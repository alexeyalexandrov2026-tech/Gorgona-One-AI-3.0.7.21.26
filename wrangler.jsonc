{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gorgonaoneai3072126",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers AI answers the concierge chat (app/api/chat). No API key: the
  // model is reached through this binding, billed to this Cloudflare account.
  "ai": {
    "binding": "AI"
  },
  // The Workers AI model the concierge uses (read by app/api/chat as
  // process.env.WORKERS_AI_MODEL). Remove it to fall back to the default in
  // lib/ai/workersAi.mjs.
  "vars": {
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  "observability": {
    "enabled": true
  }
}
