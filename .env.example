# Copy to .env.local for local development. In production set the same names
# as Cloudflare Worker variables/secrets. Never commit real values.

# ---------------------------------------------------------------------------
# Supabase - accounts, partner portal, bookings, sportsbook profiles.
#
# Both values are public by design (they ship to the browser); the anon key
# can only do what the row level security in database/ allows. Without them
# the site still renders, but sign-in, the portals and stored bookings do not
# work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional - server-side reads of public.listings for /api/search. That table
# does not exist yet (database/README.md); leave these empty and search uses
# the bundled data in lib/*Data.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Email (Resend) - reservation requests (/api/book) and partner activity
# (/api/notify) are emailed to ADMIN_EMAIL.
#
# Without both values partner events are only logged, and a reservation that
# can be neither stored nor emailed is refused with an error the guest sees.
RESEND_API_KEY=
ADMIN_EMAIL=

# Sender address on a domain verified in Resend. Reservations default to
# Resend's test sender, which only delivers to the Resend account owner;
# partner notifications default to notifications@gorgona-one.com.
NOTIFICATIONS_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Concierge engines - every value is optional.
#
# /api/chat tries the local Gorgona AI Brain, then the ai-router, then answers
# with a polite "temporarily unavailable" line. A Cloudflare Worker cannot
# reach localhost, so in production point GORGONA_AI_URL or AI_ROUTER_URL at
# hosted services, or the concierge only gives that line.

# Local Gorgona AI Brain (FastAPI + Ollama). Start the service with
# `uvicorn app.main:app` (or `python -m app.main`) and make sure
# `ollama serve` is running behind it.
GORGONA_AI_URL=http://127.0.0.1:8000
# The key the service itself expects, if it has one. Use a long random value.
GORGONA_AI_API_KEY=

# Set to 'off' to bypass the local service entirely.
GORGONA_AI_ENABLED=on

# Ollama model tag. Leave empty (recommended): the service resolves an
# installed tag itself and falls back to whatever is pulled, which beats us
# naming a model it may not have.
GORGONA_AI_MODEL=

# Optional - pin the contract instead of detecting it. Left unset, the adapter
# calls GET /api/health; a HealthStatus body identifies the service and its
# POST /api/v1/chat/completions endpoint. If the service ever moves, it reads
# FastAPI's own /openapi.json, then probes conventional paths.
#   GORGONA_AI_PATH      e.g. /api/v1/chat/completions
#   GORGONA_AI_PROTOCOL  gorgona | openai | ollama | ollama-generate | simple
GORGONA_AI_PATH=
GORGONA_AI_PROTOCOL=

# Optional tuning. Defaults suit a local model on CPU.
#   TIMEOUT_MS         guest-facing completion budget (default 45000). The
#                      service's own ceiling is LLM_TIMEOUT_SECONDS (120s).
#   PROBE_TIMEOUT_MS   health/discovery budget (default 2500)
#   FAILURE_THRESHOLD  consecutive misses before the circuit breaker trips (2)
#   COOLDOWN_MS        how long the breaker stays open (default 30000)
#   VERBOSE            'on' logs every upstream miss instead of once per cooldown
GORGONA_AI_TIMEOUT_MS=
GORGONA_AI_PROBE_TIMEOUT_MS=
GORGONA_AI_FAILURE_THRESHOLD=
GORGONA_AI_COOLDOWN_MS=
GORGONA_AI_VERBOSE=

# GET /api/chat reports engine URLs and status outside production; set 'on'
# to see the same details in production while debugging.
GORGONA_AI_DIAGNOSTICS=

# ai-router (OpenAI-compatible, ai-router/). `npm run dev` starts it on port
# 20128, the default used when AI_ROUTER_URL is empty.
AI_ROUTER_URL=
# Only needed when the router requires API keys (its REQUIRE_API_KEY=true).
AI_ROUTER_API_KEY=
# Model name sent to the ai-router.
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Optional - Cloudflare Web Analytics beacon token.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
