# Google Gemini API key powering the Discovery Room / AI Dock concierge.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional - defaults to the cheapest current Flash model if unset.
GEMINI_MODEL=gemini-2.0-flash

# Optional - admin email notifications for partner portal activity
# (/app/api/notify). With either value unset the route logs the event and
# returns success, so partner submissions never fail on an unconfigured mailer.
RESEND_API_KEY=
ADMIN_EMAIL=

# Optional - overrides the notification sender. Must be a domain verified in
# Resend. Defaults to notifications@gorgona-one.com.
NOTIFICATIONS_FROM_EMAIL=
