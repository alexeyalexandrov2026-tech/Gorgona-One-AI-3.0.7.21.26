# ---------------------------------------------------------------------------
# Concierge chat engines (app/api/chat). Tried in this order:
#
#   1. Cloudflare Workers AI   production; needs nothing here, see below
#   2. local Miami Elio AI Brain (GORGONA_AI_*)
#   3. ai-router (AI_ROUTER_*)
#   4. the concierge's own line plus navigation cards
#
# Workers AI is reached through the `AI` binding in wrangler.jsonc, so it has
# no key and exists only on Cloudflare. Locally the chain starts at link 2.
# On Cloudflare, links 2 and 3 are skipped while they point at localhost.
#
# Optional - the Workers AI model. A smaller one stretches the daily allowance
# further; replies outside English get weaker.
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional - the ai-router. Defaults to the local instance on :20128. Point it
# at a public HTTPS address to use the router from Cloudflare as well.
AI_ROUTER_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=

# ---------------------------------------------------------------------------
# Local Miami Elio AI Brain (FastAPI + Ollama)
#
# Preferred engine for the concierge chat. EVERY VALUE BELOW IS OPTIONAL: with
# the service stopped the site falls back to the hosted chain and behaves
# exactly as before, so nothing here is required to run, build, or deploy.
#
# Start the service with `uvicorn app.main:app` (or `python -m app.main`) and
# make sure `ollama serve` is running behind it. Check the wiring at any time
# by opening /api/chat in a browser - it reports engine status without
# spending a completion.
#
# Base URL of the FastAPI process. Its own default is HOST=0.0.0.0 PORT=8000.
GORGONA_AI_URL=http://127.0.0.1:8000
# Must match the key the service itself was started with. Never commit a real one.
GORGONA_AI_API_KEY=

# Set to 'off' to bypass the local service entirely. Worth doing for the
# Cloudflare Workers build, where localhost is not reachable anyway.
GORGONA_AI_ENABLED=on

# Ollama model tag. Leave empty (recommended): the service resolves an
# installed tag itself and falls back to whatever is pulled, which beats us
# naming a model it may not have.
GORGONA_AI_MODEL=

# Optional - pin the contract instead of detecting it. Left unset, the adapter
# calls GET /api/health; a HealthStatus body identifies the service and its
# POST /api/v1/chat/completions endpoint. If the service ever moves, it reads
# FastAPI's own /openapi.json, then probes conventional paths.
#   GORGONA_AI_PATH      e.g. /api/v1/chat/completions
#   GORGONA_AI_PROTOCOL  gorgona | openai | ollama | ollama-generate | simple
GORGONA_AI_PATH=
GORGONA_AI_PROTOCOL=

# Optional tuning. Defaults suit a local model on CPU.
#   TIMEOUT_MS         guest-facing completion budget (default 45000). The
#                      service's own ceiling is LLM_TIMEOUT_SECONDS (120s).
#   PROBE_TIMEOUT_MS   health/discovery budget (default 2500)
#   FAILURE_THRESHOLD  consecutive misses before the circuit breaker trips (2)
#   COOLDOWN_MS        how long the breaker stays open (default 30000)
#   VERBOSE            'on' logs every upstream miss instead of once per cooldown
GORGONA_AI_TIMEOUT_MS=
GORGONA_AI_PROBE_TIMEOUT_MS=
GORGONA_AI_FAILURE_THRESHOLD=
GORGONA_AI_COOLDOWN_MS=
GORGONA_AI_VERBOSE=

# ---------------------------------------------------------------------------
# Google Gemini API key powering the Discovery Room / AI Dock concierge.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional - defaults to the cheapest current Flash model if unset.
GEMINI_MODEL=gemini-2.0-flash

# Server-only dashboard and notification configuration.
# Never use NEXT_PUBLIC_ for these values. Missing channels remain queued.
SUPABASE_SERVICE_ROLE_KEY=
BOOKING_RATE_SECRET=
DASHBOARD_OUTBOX_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
RESEND_API_KEY=
ADMIN_EMAIL=
NOTIFICATIONS_FROM_EMAIL=
