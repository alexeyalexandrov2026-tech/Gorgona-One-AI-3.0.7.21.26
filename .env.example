# ---------------------------------------------------------------------------
# The AI concierge runs on Cloudflare Workers AI only: the CONCIERGE_AI binding
# and CONCIERGE_WORKERS_AI_ENABLED live in wrangler.jsonc, not here. With it
# disabled, /api/chat answers from the authored catalogue fallback.

# Server-only dashboard and notification configuration.
# Never use NEXT_PUBLIC_ for these values. Missing channels remain queued.
SUPABASE_SERVICE_ROLE_KEY=
BOOKING_RATE_SECRET=
DASHBOARD_OUTBOX_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
RESEND_API_KEY=
ADMIN_EMAIL=
NOTIFICATIONS_FROM_EMAIL=

# Twilio SMS to the owner only. Disabled until compliance, secrets and DB switch are verified.
# Use Cloudflare Workers encrypted Secrets, never commit real values.
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_OWNER_PHONE=

# Dining release controls (server-only). Leave false until the additive migration is verified.
# Keep schema=true after migration even when writes are disabled, to retain inquiry history.
DINING_SCHEMA_ENABLED=false
DINING_REQUESTS_ENABLED=false
DINING_EDITOR_ENABLED=false
DINING_EDITOR_WRITES_ENABLED=false
