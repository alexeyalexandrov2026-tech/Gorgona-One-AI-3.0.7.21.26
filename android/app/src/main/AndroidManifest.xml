<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for only when the guest taps the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Asked for only when the guest taps a season bell (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Season reminders are set again after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The app works on phones without a microphone; voice input is simply absent there. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <!-- The phone's speech recognition service, for dictation. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Browsers that can show a partner's page in a tab over the app. -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiamiElio"
        android:usesCleartextTraffic="false">

        <!--
          One screen for the life of the app: the two web views keep their
          pages through a rotation, a language change or a folded screen.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- miamielio://open?path=/yachts, miamielio://concierge, miamielio://search, miamielio://account -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="miamielio" />
            </intent-filter>
        </activity>

        <receiver android:name=".season.ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
