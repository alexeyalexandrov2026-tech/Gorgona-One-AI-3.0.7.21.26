<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      What the window looks like before Compose draws its first frame: the
      site's dark paper, so the app never flashes white. The app has one
      appearance, dark, whatever the phone is set to.
    -->
    <style name="Theme.MiamiElio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
