{
  "name": "gorgona-one",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run i18n:check",
    "dev": "concurrently \"next dev\" \"cd ai-router && npm install && set PORT=20128&& npm run dev\"",
    "build": "NEXT_PRIVATE_STANDALONE=true next build && node scripts/i18n/build-worker.mjs && cd ai-router && npm install && npm run build",
    "start": "concurrently \"next start\" \"cd ai-router && set PORT=20128&& npm run start\"",
    "i18n:extract": "node scripts/i18n/catalogue.mjs --extract",
    "i18n:check": "node scripts/i18n/check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "autoprefixer": "^10.5.2",
    "framer-motion": "11.18.2",
    "next": "15.5.28",
    "postcss": "8.5.31",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "resend": "^6.18.1",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@electric-sql/pglite": "0.5.11",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.61.1",
    "concurrently": "10.0.6",
    "playwright": "^1.61.1"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
