{
  "name": "gorgona-one",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \"cd ai-router && npm install && set PORT=20128&& npm run dev\"",
    "build": "NEXT_PRIVATE_STANDALONE=true next build && opennextjs-cloudflare build --skipNextBuild --openNextConfigPath open-next.config.mjs && cd ai-router && npm install && npm run build",
    "start": "concurrently \"next start\" \"cd ai-router && set PORT=20128&& npm run start\"",
    "i18n:pilot:extract": "gt generate",
    "i18n:pilot:snapshot": "node scripts/i18n/pilot-resources.mjs --write",
    "i18n:pilot:check": "gt validate && node scripts/i18n/pilot-resources.mjs && node --test tests/i18n/*.test.mjs",
    "i18n:pilot:dev": "node scripts/i18n/run-pilot.mjs dev",
    "i18n:pilot:build": "node scripts/i18n/run-pilot.mjs build",
    "i18n:pilot:translate": "gt translate --timeout 180 && node scripts/i18n/pilot-resources.mjs --write",
    "i18n:pilot:start": "node scripts/i18n/run-pilot.mjs start",
    "i18n:pilot:e2e": "playwright test --config playwright.i18n.config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "autoprefixer": "^10.5.2",
    "framer-motion": "^11.11.17",
    "gt-next": "11.4.14",
    "gt-react": "11.4.14",
    "next": "14.2.35",
    "postcss": "^8.5.16",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.18.1",
    "tailwindcss": "^3.4.13"
  },
  "devDependencies": {
    "@generaltranslation/compiler": "1.3.64",
    "@opennextjs/cloudflare": "1.15.1",
    "@playwright/test": "^1.61.1",
    "concurrently": "^10.0.3",
    "gt": "2.26.6",
    "playwright": "^1.61.1",
    "unplugin": "2.3.11"
  }
}
